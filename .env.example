# Copy this file to .env.local and fill it in. Never commit .env.local.

# Required
CANVAS_BASE_URL=https://yourschool.instructure.com
CANVAS_TOKEN=

# Optional: Google Calendar secret iCal link(s), comma-separated
GOOGLE_CALENDAR_ICS_URL=

# Optional: morning email digest (Resend)
RESEND_API_KEY=
DIGEST_TO_EMAIL=
DIGEST_FROM_EMAIL=

# Optional
DASHBOARD_TIMEZONE=America/New_York
CRON_SECRET=
