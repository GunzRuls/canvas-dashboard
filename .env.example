# Optional. Most people should use the setup screen the dashboard shows on first launch.
# To configure by file instead, copy this to .env.local and fill it in. Never commit .env.local.
# Anything saved on the setup screen (dashboard-config.json) takes priority over this file.

# Required
CANVAS_BASE_URL=https://yourschool.instructure.com
CANVAS_TOKEN=

# Optional: Google Calendar secret iCal link(s), comma-separated
GOOGLE_CALENDAR_ICS_URL=

# Optional: morning email (DIGEST_PROVIDER=gmail with an app password, or resend)
# DIGEST_TIME is HH:MM; DIGEST_DAYS is weekdays or daily. Settings sets these for you.
DIGEST_PROVIDER=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
DIGEST_TO_EMAIL=
DIGEST_FROM_EMAIL=
DIGEST_TIME=07:00
DIGEST_DAYS=weekdays

# Optional
DASHBOARD_TIMEZONE=America/New_York
CRON_SECRET=
